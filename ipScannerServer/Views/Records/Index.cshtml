@model Server.Models.RecordsPageModel

@{
    Layout = "_Layout";
}



<div class="min-h-screen  bg-base-200">
    <div class="mx-auto max-w-8xl p-6 space-y-6">
        <div class="card bg-base-100 shadow">
            <div class=" mx-auto card-body gap-3 relative">

                <form asp-controller="Records" asp-action="Search" method="post" id="searchForm"
                      class="flex flex-col gap-3 md:flex-row  md:items-center">

                    <label class="form-control w-full md:max-w-xs">
                        <div class="label">
                            <span class="label-text">IP:</span>
                        </div>
                        <input asp-for="Request.Ip"
                               placeholder="Enter IP"
                               id="searchIP"
                               class="input input-bordered w-full" />
                    </label>

                    <label class="form-control w-full md:max-w-xs">
                        <div class="label">
                            <span class="label-text">Hostname:</span>
                        </div>
                        <input asp-for="Request.Hostname"
                               placeholder="Enter hostname"
                               id="searchHost"
                               class="input input-bordered w-full" />
                    </label>

                    <label class="form-control w-full md:max-w-xs">
                        <div class="label">
                            <span class="label-text">User:</span>
                        </div>
                        <input asp-for="Request.LastLoggedUser"
                               placeholder="Enter username"
                               id="searchUser"
                               class="input input-bordered w-full" />
                    </label>

                    <label class="form-control w-full md:max-w-xs">
                        <div class="label">
                            <span class="label-text">Operating System:</span>
                        </div>
                        <input asp-for="Request.OperatingSystem"
                               placeholder="Enter OS"
                               id="searchOS"
                               class="input input-bordered w-full" />
                    </label>

                    <label class="form-control w-full md:max-w-xs">
                        <div class="label">
                            <span class="label-text">Serial Number:</span>
                        </div>
                        <input asp-for="Request.SerialNumber"
                               placeholder="Enter serial number"
                               id="searchSN"
                               class="input input-bordered w-full" />
                    </label>

                    <label class="form-control w-full md:max-w-xs">
                        <div class="label">
                            <span class="label-text">Model:</span>
                        </div>
                        <input asp-for="Request.Model"
                               placeholder="Enter model"
                               id="searchModel"
                               class="input input-bordered w-full" />
                    </label>

                    
                        
                    <label class="form-control md:max-w-xs">
                        <br />
                        <button class="btn btn-primary md:w-auto w-full"
                                type="submit"
                                id="searchButton">
                            Search
                        </button>
                    </label>

                        
                    

                    
                    <fieldset class="fieldset bg-base-100 border-base-300 rounded-box w-64 border p-4">
                      <legend class="fieldset-legend">View options:</legend>
                      <label class="label">
                            <input asp-for="Request.skipEmpty" type="checkbox" id="skipEmptyCheckBox" class="checkbox checkbox-secondary" />
                        Skip empty records
                      </label>

                      <div class="dropdown dropdown-hover">
                        <div tabindex="0" role="button" class="btn m-1">Order by:</div>
                        <ul tabindex="-1" class="dropdown-content menu bg-base-300 rounded-box z-1 w-52 p-2 absolute z-50">
                        <li><a data-column="0">Ip Address</a></li>
                        <li><a data-column="1"> Hostname</a></li>
                        <li><a data-column="2">LastLoggedUser</a></li>
                        <li><a data-column="3">LastFoundDate</a></li>
                        <li><a data-column="4">OperatingSystem</a></li>
                        <li><a data-column="5">SerialNumber</a></li>
                        <li><a data-column="6">Model</a></li>
                        <li><a data-column="6">Proc_gen</a></li>
                      </ul>
                    </div>

                    </fieldset>
                    
                    
                    

                </form>

                <div class="text-sm opacity-70">
                    <p>Results update automatically while typing.</p>

                </div>
                
            </div>
        </div>


        

        @if (Model?.Results?.Any() == true)
        {
            <div class="card bg-base-100 shadow">
                <div class="card-body">
                    <div class="flex items-center justify-between gap-3">
                        <h2 class="card-title">Results</h2>
                        <div class="badge badge-neutral">@Model.Results.Count</div>
                    </div>

                    <div class="overflow-y-auto overflow-x-auto mt-2" style="max-height:500px;">
                        <table class="table">
                            <thead class="sticky top-0 bg-base-100">
                                <tr>
                                    <th data-type="ip">Ip Address</th>
                                    <th>Hostname</th>
                                    <th>LastLoggedUser</th>
                                    <!-- <th>LastCheckedDate</th> -->
                                    <th>LastFoundDate</th>
                                    <th>OperatingSystem</th>
                                    <th>Serial</th>
                                    <th>Model</th>
                                    <th>ProcGen</th>
                                </tr>
                            </thead>
                            <tbody>
                                <div id="errorAlert" role="alert" class="alert alert-error hidden transition-all duration-300  opacity-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    <span id="errorSpan"></span>
                                </div>

                                @foreach (var ip in Model.Results)
                                {
                                    <tr class="hover:bg-base-300" onclick="toggleRow(this,@Model?.Results?.Count())">
                                        <td>@ip.Ip</td>
                                        <td>@ip.Hostname</td>
                                        <td>@ip.LastLoggedUser</td>
										<!-- <td>@ip.LastCheckedDate</td> -->
										<td>@ip.LastFoundDate</td>
                                        <td>@ip.OperatingSystem</td>
                                        <td>@ip.SerialNumber</td>
                                        <td>@ip.Model</td>
                                        <td>@ip.ProcGen</td>
                                    </tr>

                                    <tr class="hidden">
                                        <td colspan="9">
                                            <div class="p-4 bg-base-200 rounded">
                                          More information here
                                        </div>
                                      </td>
                                    </tr>

                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert">
                <span>No records to show.</span>
            </div>
        }
    </div>
</div>



