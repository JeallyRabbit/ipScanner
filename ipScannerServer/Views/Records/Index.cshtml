@model Server.Models.RecordsPageModel
@using System.Text.Json

@{
	Layout = "_Layout";

	const int MIN_SLIDER_VALUE=1;
	const int MAX_SLIDER_VALUE=100;
	int sliderValue=10;

	var jsModel = new
	{
		records = Model.Results,
		maxRowsPrint = @sliderValue,
		sortingBy=""
	};

	
}

<head>
	<!-- two paragraphs to hide switches of sorting-->
	<p type="" id="OrderBy" name="Request.OrderBy" asp-for="Request.OrderBy" />
	<p type="" id="Asc" name="Request.Asc" value="!Request.Asc" asp-for="Request.Asc" />
</head>

<script id="page-data" type="application/json">
	@Html.Raw(JsonSerializer.Serialize(jsModel))	
</script>


<div class="card card-border bg-base-200">
	<div class="p-6 space-y-6 ">
		<div class="card bg-base-100 shadow">
			<div class="mx-auto card-body gap-3 relative border-base-300 ">

				<form asp-controller="Records" asp-action="Search" method="post" id="searchForm"
					  class="flex flex-col gap-3 md:flex-row  md:items-center">

					<label class="form-control w-full md:max-w-xs">
						<div class="label">
							<span class="label-text">IP:</span>
						</div> 
						<input asp-for="Request.Ip"
							   placeholder="Enter IP"
							   id="searchIP"
							   class="input input-bordered w-full" />
					</label>

					<label class="form-control w-full md:max-w-xs">
						<div class="label">
							<span class="label-text">Hostname:</span>
						</div>
						<input asp-for="Request.Hostname"
							   placeholder="Enter hostname"
							   id="searchHost"
							   class="input input-bordered w-full" />
					</label>

					<label class="form-control w-full md:max-w-xs">
						<div class="label">
							<span class="label-text">User:</span>
						</div>
						<input asp-for="Request.LastLoggedUser"
							   placeholder="Enter username"
							   id="searchUser"
							   class="input input-bordered w-full" />
					</label>

					<label class="form-control w-full md:max-w-xs">
						<div class="label">
							<span class="label-text">Operating System:</span>
						</div>
						<input asp-for="Request.OperatingSystem"
							   placeholder="Enter OS"
							   id="searchOS"
							   class="input input-bordered w-full" />
					</label>

					<label class="form-control w-full md:max-w-xs">
						<div class="label">
							<span class="label-text">Serial Number:</span>
						</div>
						<input asp-for="Request.SerialNumber"
							   placeholder="Enter serial number"
							   id="searchSN"
							   class="input input-bordered w-full" />
					</label>

					<label class="form-control w-full md:max-w-xs">
						<div class="label">
							<span class="label-text">Model:</span>
						</div>
						<input asp-for="Request.Model"
							   placeholder="Enter model"
							   id="searchModel"
							   class="input input-bordered w-full" />
					</label>



					<label class="form-control md:max-w-xs">
						<br />
						<button class="btn btn-primary md:w-auto w-full"
								type="submit"
								id="searchButton">
							Search
						</button>
					</label>





					<fieldset class="fieldset bg-base-100 border-base-300 rounded-box w-64 border p-4">
						<legend class="fieldset-legend">View options:</legend>
						<label class="label">
							<input asp-for="Request.skipEmpty" type="checkbox" id="skipEmptyCheckBox" class="checkbox checkbox-secondary" />
							Skip empty records
						</label>

						<div class="dropdown dropdown-hover">
							<div tabindex="0" role="button" class="btn m-1">Order by:</div>
							<ul tabindex="-1" class="dropdown-content menu bg-base-300 rounded-box z-1 w-52 p-2 absolute z-50">
								<li><a data-property="Ip">Ip Address</a></li>
								<li><a data-property="Hostname">Hostname</a></li>
								<li><a data-property="LastLoggedUser">LastLoggedUser</a></li>
								<li><a data-property="LastFoundDate">LastFoundDate</a></li>
								<li><a data-property="OperatingSystem">OperatingSystem</a></li>
								<li><a data-property="SerialNumber">SerialNumber</a></li>
								<li><a data-property="Model">Model</a></li>
								<li><a data-property="ProcGen">Proc_gen</a></li>
							</ul>
						</div>

					</fieldset>




				</form>

				<div class="text-sm opacity-70">
					
					<p>Results update automatically while typing.</p>

				</div>

			</div>
		</div>




@if (Model?.Results?.Any() == true)
{
			<div class="card bg-base-100 shadow">
				<div class="card-body  ">

					


					<div class="flex items-center w-full justify-between gap-3">@*justify-between gap-3*@
						<h2 class="card-title">Results</h2>
						<div style="position:relative;">
							Amount of records on page: @MIN_SLIDER_VALUE
							<input type="range" id="rowsSlider" class="range range-accent range-lg w-[300px]" min="@MIN_SLIDER_VALUE" value="@sliderValue" max="@MAX_SLIDER_VALUE" />
							@MAX_SLIDER_VALUE

							 <span id="sliderPrintValue" style="position:absolute;top:2px; left:66%;transform:translateX(-66%);">
								@sliderValue
								</span> 
							
						</div>

						

						<div class="badge badge-neutral">@Model.Results.Count</div>
					</div>
					<div id="errorAlert" role="alert" class="alert alert-error hidden transition-all duration-300  opacity-0">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
						<span id="errorSpan"></span>
					</div>


					<div class="mt-2">
						<div class="tabs tabs-box">

							

							@{
								//here get value of slider
								int MAX_ROWS = sliderValue;
								double auxMaxRows = (double)sliderValue;
								double auxRowsCount = (double)(Model.Results.Count);
								double auxTabNum = Math.Ceiling(auxRowsCount / auxMaxRows);
								int tabNum = (int)auxTabNum;

								<div class="p-2  min-w-full">
									<div class="tabs" id="tabsDiv">

										
										@for (int i = 0; i < tabNum; i++)
										{
											if (i == 0)
											{
												<input type="radio" name="radio" id="tab{@i}" checked="checked" class="tab" aria-label="@(i + 1)" />
											}
											else
											{
												<input type="radio" name="radio" id="tab{@i}" class="tab [--tab-bg:var(--color-accent)]" aria-label=" @(i + 1) " />

											}


											<div class="sticky tab-content h-120 overflow-x-auto border-base-300 bg-base-100 p-2">

												<table class="table table-pin-rows table-pin-cols">
													<thead class="sticky top-0 bg-base-100">
														<tr>
															<th data-property="Ip" class="ipHeader">Ip Address</th>
															<th data-property="Hostname">Hostname</th>
															<th data-property="LastLoggedUser">Last Logged User</th>
															<th data-property="LastFoundDate">Last Found Date</th>
															<th data-property="OperatingSystem">OperatingSystem</th>
															<th data-property="SerialNumber">Serial</th>
															<th data-property="Model">Model</th>
															<th data-property="ProcGen">ProcGen</th>
														</tr>
													</thead>

													<tbody>
														@for (int j = 0; j < MAX_ROWS; j++)
														{
															@if ((i * MAX_ROWS) + j == Model.Results.Count)
															{
																break;
															}

															var ip = Model.Results[(i * MAX_ROWS) + j];
															var aux = (i * MAX_ROWS) + j;
															<tr class="hover:bg-base-300  tableRow{@aux}" onclick="toggleRow(this,@Model?.Results?.Count())">
																<td id="ipRow{@aux}">@ip.Ip</td>
																<td id="hostnameRow{@aux}">@ip.Hostname</td>
																<td id="userRow{@aux}">@ip.LastLoggedUser</td>
																<td id="foundRow{@aux}">@ip.LastFoundDate</td>
																<td id="osRow{@aux}">@ip.OperatingSystem</td>
																<td id="snRow{@aux}">@ip.SerialNumber</td>
																<td id="modelRow{@aux}">@ip.Model</td>
																<td id="procGenRow{@aux}">@ip.ProcGen</td>
															</tr>

															<tr class="hidden">
																<td colspan="9">
																	<div class="card card-border p-4 bg-base-200" id="tableRowHidden{@aux}">
																		More information about @ip.Ip here
																	</div>
																</td>
															</tr>
														}
													</tbody>
												</table>
											</div>
										}
									</div>
								</div>
							}


						</div>
					</div>
				</div>
			</div>
}
</div>
</div>


