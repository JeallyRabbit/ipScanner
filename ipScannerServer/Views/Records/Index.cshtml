@model Server.Models.RecordsPageModel

@{
    Layout = "_Layout";
}



<div class="min-h-screen  bg-base-200">
    <div class="mx-auto max-w-8xl p-6 space-y-6">
        <div class="card bg-base-100 shadow">
            <div class=" mx-auto card-body gap-4">

                <form asp-controller="Records" asp-action="Search" method="post" id="searchForm"
                      class="flex flex-col gap-3 md:flex-row md:items-end">

                    <label class="form-control w-full md:max-w-xs">
                        <div class="label">
                            <span class="label-text">IP:</span>
                        </div>
                        <input asp-for="Request.Ip"
                               placeholder="Enter IP"
                               id="searchIP"
                               class="input input-bordered w-full" />
                    </label>

                    <label class="form-control w-full md:max-w-sm">
                        <div class="label">
                            <span class="label-text">Hostname:</span>
                        </div>
                        <input asp-for="Request.Hostname"
                               placeholder="Enter hostname"
                               id="searchHost"
                               class="input input-bordered w-full" />
                    </label>

                    <label class="form-control w-full md:max-w-sm">
                        <div class="label">
                            <span class="label-text">User:</span>
                        </div>
                        <input asp-for="Request.LastLoggedUser"
                               placeholder="Enter username"
                               id="searchUser"
                               class="input input-bordered w-full" />
                    </label>

                    <button class="btn btn-primary md:w-auto w-full"
                            type="submit"
                            id="searchButton">
                        Search
                    </button>

                    <fieldset class="fieldset bg-base-100 border-base-300 rounded-box w-64 border p-4">
                      <legend class="fieldset-legend">View options:</legend>
                      <label class="label">
                            <input asp-for="Request.skipEmpty" type="checkbox" id="skipEmptyCheckBox" class="checkbox checkbox-secondary" />
                        Skip empty records
                      </label>
                    </fieldset>


                </form>

                <div class="text-sm opacity-70">
                    Results update automatically while typing.
                </div>
            </div>
        </div>


        

        @if (Model?.Results?.Any() == true)
        {
            <div class="card bg-base-100 shadow">
                <div class="card-body">
                    <div class="flex items-center justify-between gap-3">
                        <h2 class="card-title">Results</h2>
                        <div class="badge badge-neutral">@Model.Results.Count</div>
                    </div>

                    <div class="overflow-y-auto overflow-x-auto mt-2" style="max-height:500px;">
                        <table class="table">
                            <thead class="sticky top-0 bg-base-100">
                                <tr>
                                    <th data-type="ip">Address</th>
                                    <th>Hostname</th>
                                    <th>LastLoggedUser</th>
                                    <!-- <th>LastCheckedDate</th> -->
                                    <th>LastFoundDate</th>
                                    <th>OperatingSystem</th>
                                    <th>Serial</th>
                                    <th>Model</th>
                                    <th>ProcGen</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ip in Model.Results)
                                {
                                    <tr class="hover">
                                        <td>@ip.Ip</td>
                                        <td>@ip.Hostname</td>
                                        <td>@ip.LastLoggedUser</td>
										<!--<td>@ip.LastCheckedDate</td> -->
										<td>@ip.LastFoundDate</td>
                                        <td>@ip.OperatingSystem</td>
                                        <td>@ip.SerialNumber</td>
                                        <td>@ip.Model</td>
                                        <td>@ip.ProcGen</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert">
                <span>No records to show.</span>
            </div>
        }
    </div>
</div>

<script>
    
    document.querySelectorAll("#searchForm input").forEach(el => {
        el.addEventListener("focus", () => sessionStorage.setItem("focusedInput", el.id));
    });

    // restore focus after reload
    window.addEventListener("load", () => {
        const id = sessionStorage.getItem("focusedInput");
        if (!id) return;
        const el = document.getElementById(id);
        if (el){ 
            el.focus();
            el.selectionStart = el.selectionEnd = el.value.length;
        }
    });

    const form = document.getElementById("searchForm");
    const ipInput = document.getElementById("searchIP");
    const hostInput = document.getElementById("searchHost");
      const userNameInput = document.getElementById("searchUser");
    const emptyCheckBox=document.getElementById("skipEmptyCheckBox");
    

    console.log(userNameInput)

    ipInput.addEventListener("input", triggerSearch);
    hostInput.addEventListener("input", triggerSearch);
      userNameInput.addEventListener("input",triggerSearch);

    emptyCheckBox.addEventListener("input",triggerSearch);
      
        console.log(userNameInput)

    let timer;

    function triggerSearch() {
        clearTimeout(timer);

        // don't spam submits on empty
         if (!ipInput.value && !hostInput.value && !userNameInput.value) return;

        timer = setTimeout(() => {
            console.log("Sending form")
            form.submit();
        }, 1000);
    }


    document.addEventListener("DOMContentLoaded", () => {

  function ipToNumber(ip) {
    // Handles typical IPv4 like "192.168.1.10"
    // Returns NaN if invalid
    const parts = ip.trim().split(".");
    if (parts.length !== 4) return NaN;

    let n = 0;
    for (let i = 0; i < 4; i++) {
      const p = Number(parts[i]);
      if (!Number.isInteger(p) || p < 0 || p > 255) return NaN;
      n = n * 256 + p;
    }
    return n;
  }

  function getSortValue(text, type) {
    const v = (text ?? "").trim();

    if (type === "ip") return ipToNumber(v);
    if (type === "number") {
      const num = Number(v.replace(",", "."));
      return Number.isFinite(num) ? num : NaN;
    }

    // default text
    return v.toLowerCase();
  }

  // Attach to all header cells
  document.querySelectorAll("table.table thead th").forEach((th, index) => {

        th.style.cursor = "pointer";

        th.addEventListener("click", () => {

          const table = th.closest("table");
          const tbody = table.tBodies[0];
          if (!tbody) return;

          // Determine direction per-table + per-column
          const key = `sortDir_${index}`;
          const asc = table.dataset[key] !== "asc";
          table.dataset[key] = asc ? "asc" : "desc";

          // Optional: clear classes on other headers, set on this one
          table.querySelectorAll("thead th").forEach(h => h.classList.remove("asc", "desc"));
          th.classList.add(asc ? "asc" : "desc");

          const type = th.dataset.type || "text";

          const rows = Array.from(tbody.rows);

          rows.sort((a, b) => {
            const Araw = a.cells[index]?.textContent ?? "";
            const Braw = b.cells[index]?.textContent ?? "";

            const A = getSortValue(Araw, type);
            const B = getSortValue(Braw, type);

            // Put invalid/empty values at the bottom
            const Aok = (type === "text") ? true : Number.isFinite(A);
            const Bok = (type === "text") ? true : Number.isFinite(B);

            if (type !== "text") {
              if (!Aok && !Bok) return 0;
              if (!Aok) return 1;
              if (!Bok) return -1;
              return asc ? (A - B) : (B - A);
            }

            // Text compare
            return asc ? A.localeCompare(B) : B.localeCompare(A);
          });

          rows.forEach(r => tbody.appendChild(r));
        });
      });

    });


</script>
