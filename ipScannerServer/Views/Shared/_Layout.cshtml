<!DOCTYPE html>

<html data-theme="coffee">
<head>

    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />


    <meta name="viewport" content="width=device-width" />
    
    
    
    <title>ipScanner</title>

    <style>
        table.table thead th.asc::after { content: " ▲"; }
        table.table thead th.desc::after { content: " ▼"; }
    </style>
   

   <script>
function setTheme(theme) {
  document.documentElement.setAttribute("data-theme", theme)
  localStorage.setItem("theme", theme)
}

// load saved theme
const saved = localStorage.getItem("theme")
if (saved) {
  document.documentElement.setAttribute("data-theme", saved)
}
</script>


</head>

@*
<script src="https://cdn.jsdelivr.net/npm/animejs/lib/anime.min.js"></script>

*@

<body class="min-h-screen" style="transition: 0.3s ease;" data-auto-animate>

    <header class="navbar bg-base-200 px-4">
      <div class="flex-1">
        <span class="text-xl font-bold">Server Admin</span>

        <div class="flex flex-wrap items-center gap-6 mt-3">
            Themes:

          <button data-theme="light"
            onclick="setTheme('light')"
            class="btn btn-primary rounded-full border px-4 border-base-300">
            Light
          </button>

          <button data-theme="dark"
            onclick="setTheme('dark')"
            class="btn btn-primary rounded-full px-4 border border-base-300">
            Dark
          </button>

          <button data-theme="cupcake"
            onclick="setTheme('cupcake')"
            class="btn btn-primary rounded-full px-4 border border-base-300">
            Cupcake
          </button>

          <button data-theme="emerald"
            onclick="setTheme('emerald')"
            class="btn btn-primary rounded-full px-4 border border-base-300">
            Emerald
          </button>

          <button data-theme="dracula"
            onclick="setTheme('dracula')"
            class="btn btn-primary rounded-full px-4 border border-base-300">
            Dracula
          </button>

          <button data-theme="coffee"
            onclick="setTheme('coffee')"
            class="btn btn-primary rounded-full px-4 border border-base-300">
            Coffee
          </button>

          <button data-theme="luxury"
            onclick="setTheme('luxury')"
            class="btn btn-secondary rounded-full px-4 border border-base-300">
            luxury
          </button>
        </div> 
      </div>

        
    </header>


    <main class="p-4">
        @RenderBody()
    </main>

<script type="module" src="~/js/index.js"></script>
    <script src="~/lib/anime/anime.umd.min.js"></script>
@RenderSection("Scripts", required: false)

    
</body>
</html>
